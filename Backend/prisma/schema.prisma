generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model subscriptions {
  id            Int      @id @default(autoincrement())
  subscriber_id Int
  publisher_id  Int
  created_at    DateTime @default(now())
  publisher     user     @relation("AuthorSubscribers", fields: [publisher_id], references: [id], onDelete: Cascade)
  subscriber    user     @relation("UserSubscriptions", fields: [subscriber_id], references: [id], onDelete: Cascade)

  @@unique([subscriber_id, publisher_id])
  @@index([publisher_id])
}

model categories {
  id         Int      @id @default(autoincrement())
  name       String   @unique(map: "Categories_name_key") @db.VarChar(100)
  slug       String   @unique(map: "Categories_slug_key") @db.VarChar(100)
  created_at DateTime @default(now())
  posts      posts[]

  @@index([name], map: "Categories_name_idx")
}

model contactmessage {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @db.VarChar(255)
  subject    String   @db.VarChar(200)
  message    String   @db.Text
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}

model posts {
  id           Int          @id @default(autoincrement())
  author_id    Int
  category_id  Int
  title        String       @db.VarChar(500)
  slug         String       @unique(map: "Posts_slug_key") @db.VarChar(500)
  excerpt      String       @db.VarChar(500)
  content      String       @db.LongText
  cover_url    String?      @db.VarChar(500)
  status       posts_status @default(draft)
  read_time    Int          @default(1)
  published_at DateTime     @default(now())
  updated_at   DateTime?
  created_at   DateTime     @default(now())
  notify_at    DateTime?
  public_id    String?      @db.VarChar(200)
  author         user         @relation(fields: [author_id], references: [id], map: "Posts_author_id_fkey")
  category   categories   @relation(fields: [category_id], references: [id], map: "Posts_category_id_fkey")

  @@index([author_id], map: "Posts_author_id_idx")
  @@index([category_id], map: "Posts_category_id_idx")
  @@index([status, published_at], map: "Posts_status_published_at_idx")
}

model user {
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(200)
  email               String          @unique(map: "User_email_key") @db.VarChar(200)
  password            String          @db.VarChar(100)
  role                user_role       @default(READER)
  avatar_url          String?         @db.VarChar(500)
  bio                 String?         @db.VarChar(300)
  verify_token        String?         @unique(map: "User_verify_token_key") @db.VarChar(255)
  verify_token_expiry DateTime?
  reset_token         String?         @db.VarChar(255)
  reset_token_expiry  DateTime?
  refresh_token       String?         @db.VarChar(255)
  created_at          DateTime        @default(now())
  updated_at          DateTime?
  is_verified         Boolean         @default(false)
  posts               posts[]
  subscribers         subscriptions[] @relation("AuthorSubscribers")
  subscriptions       subscriptions[] @relation("UserSubscriptions")
}

enum user_role {
  ADMIN
  PUBLISHER
  READER
}

enum posts_status {
  draft
  published
}
